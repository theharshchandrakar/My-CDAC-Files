  <actions>
    <action caption='Filter Revenue by region' name='[Action1_9FD18FCDF6674932864338F477515314]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Region &amp; Revenue  Dashboard' type='sheet' worksheet='Profit By Region' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Profit By Region' />
        <param name='special-fields' value='all' />
        <param name='target' value='Region &amp; Revenue  Dashboard' />
      </command>
    </action>
    <action caption='Filter Quantity  by Segment &amp; Category' name='[Action2_123244D0E2504DF38F8976AB37860EFE]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='Quantity by Category &amp; Segment Dashboard' type='sheet'>
        <exclude-sheet name='Monthly Quantity' />
      </source>
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Profit % by Category,Profit % by Segment' />
        <param name='special-fields' value='all' />
        <param name='target' value='Quantity by Category &amp; Segment Dashboard' />
      </command>
    </action>
    <action caption='Filter KPI by Country' name='[Action3_0271F08CF7AA4639979937F8101B255E]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='KPIs by Country Dashboard' type='sheet' worksheet='Country Master' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Country Master' />
        <param name='special-fields' value='all' />
        <param name='target' value='KPIs by Country Dashboard' />
      </command>
    </action>
    <action caption='Filter KPI &amp; Dual Combo by Market' name='[Action4_7B9B45ED5E4644FDA311971DAB4A8C73]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='KPI &amp; Profit by Market Dashboard' type='sheet' worksheet='No. of Customers by market' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='No. of Customers by market' />
        <param name='special-fields' value='all' />
        <param name='target' value='KPI &amp; Profit by Market Dashboard' />
      </command>
    </action>
    <action caption='Filter KPI by Month, Category &amp; Segment' name='[Action5_9022B22FF7824C5B824E5CC8C030E6A2]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='KPI by Month, Category &amp; Segment' type='sheet'>
        <exclude-sheet name='KPI 1' />
        <exclude-sheet name='KPI 2' />
      </source>
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='Monthly Shipping Cost,Profit % by Category,Profit % by Segment' />
        <param name='special-fields' value='all' />
        <param name='target' value='KPI by Month, Category &amp; Segment' />
      </command>
    </action>
    <action caption='Revenue by Category' name='[Action6_F7E529B4CDC24D1F96000A9891EA1A1A]'>
      <activation auto-clear='true' type='on-hover' />
      <source dashboard='Dashboard 7' type='sheet' worksheet='Profit % by Category' />
