        <param name='exclude' value='Profit % by Category' />
        <param name='special-fields' value='all' />
        <param name='target' value='Dashboard 7' />
      </command>
    </action>
    <action caption='Show Country Wikipedia' name='[Action7_FCA1F583A0AF40FA96797C956E686E2C]'>
