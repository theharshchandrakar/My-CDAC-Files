            <column caption='No. of Losses' datatype='integer' name='[Calculation_1101974541058703364]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Actual Profit] &lt; 0 THEN 1 ELSE 0 END&#13;&#10;)' />
            </column>
            <column caption='Days to Ship' datatype='integer' name='[Calculation_1101974541059018757]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Order Date],[Actual Ship Date])' />
            </column>
            <column caption='Avg Days to Ship' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1101974541060255750]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_1101974541059018757])' />
