            <column caption='Avg Discount Amount' datatype='real' default-format='c&quot;$&quot;#,##0.0;&quot;$&quot;-#,##0.0' name='[Calculation_1101974541062258697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Calculation_1101974541060333575])' />
