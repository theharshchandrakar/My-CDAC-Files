      <aliases enabled='yes' />
      <column caption='Quantity Type' datatype='string' name='[Calculation_1101974541055418368]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Quantity] &lt;= 5 THEN &quot;Low&quot;&#13;&#10;ELSEIF [Quantity] &lt;= 10 THEN &quot;Medium&quot;&#13;&#10;ELSE &quot;High&quot;&#13;&#10;END' />
      </column>
      <column caption='Profit Ratio' datatype='real' name='[Calculation_1101974541056974850]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Actual Profit])/SUM([Actual Revenue])' />
      </column>
      <column caption='Avg Order Value' datatype='real' name='[Calculation_1101974541057134595]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Actual Revenue])/ COUNTD([Order ID])' />
      </column>
      <column caption='No. of Losses' datatype='integer' name='[Calculation_1101974541058703364]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;    IF [Actual Profit] &lt; 0 THEN 1 ELSE 0 END&#13;&#10;)' />
      </column>
      <column caption='Days to Ship' datatype='integer' name='[Calculation_1101974541059018757]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;,[Order Date],[Actual Ship Date])' />
      </column>
      <column caption='Avg Days to Ship' datatype='real' default-format='n#,##0.0;-#,##0.0' name='[Calculation_1101974541060255750]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_1101974541059018757])' />
      </column>
      <column caption='Discount Amount' datatype='real' default-format='c&quot;$&quot;#,##0,.00K;&quot;$&quot;-#,##0,.00K' name='[Calculation_1101974541060333575]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Actual Revenue]*[Discount]' />
      </column>
      <column caption='Avg Discount Amount' datatype='real' default-format='c&quot;$&quot;#,##0.0;&quot;$&quot;-#,##0.0' name='[Calculation_1101974541062258697]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_1101974541060333575])' />
      </column>
      <column caption='Avg Order Profit' datatype='real' default-format='c&quot;$&quot;#,##0.0;&quot;$&quot;-#,##0.0' name='[Calculation_1101974541063684106]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Actual Profit])/COUNTD([Order ID])' />
      </column>
      <column caption='Avg Profit per Customer' datatype='real' default-format='c&quot;$&quot;#,##0.0' name='[Calculation_1101974541063999499]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Actual Profit])/COUNTD([Customer ID])' />
      </column>
      <column caption='East Region Profit' datatype='real' name='[Calculation_1101974541065207820]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [Region]=&quot;East&quot; THEN [Actual Profit] ELSE 0&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='No. of Male Customers' datatype='integer' name='[Calculation_1101974541067669520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum(&#13;&#10;IF [Gender]=&quot;M&quot; THEN 1 ELSE 0&#13;&#10;END&#13;&#10;)' />
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column caption='West Region Profit' datatype='real' name='[East Region Profit (copy)_1101974541066641421]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [Region]=&quot;West&quot; THEN [Actual Profit] ELSE 0&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='South Region Profit' datatype='real' name='[East Region Profit (copy)_1101974541066780686]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [Region]=&quot;South&quot; THEN [Actual Profit] ELSE 0&#13;&#10;END&#13;&#10;)' />
      </column>
      <column caption='Central Region Profit' datatype='real' name='[East Region Profit (copy)_1101974541066846223]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(&#13;&#10;IF [Region]=&quot;Central&quot; THEN [Actual Profit] ELSE 0&#13;&#10;END&#13;&#10;)' />
