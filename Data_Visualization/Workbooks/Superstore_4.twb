              <calculation class='tableau' formula='IF [Calculation_905786481558495243] &gt; 0 THEN&#13;&#10;&quot;Yes&quot;&#13;&#10;ELSE&#13;&#10;&quot;NO&quot;&#13;&#10;END' />
