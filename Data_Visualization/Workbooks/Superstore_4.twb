              <calculation class='tableau' formula='COUNTD([Order ID])' />
            </column>
            <column caption='Ship Days Delay' datatype='integer' name='[Calculation_905786481558495243]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, [Expected Ship Date], [Actual Ship Date])' />
            </column>
