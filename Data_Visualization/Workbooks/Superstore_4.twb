        <calculation class='tableau' formula='IF [Parameters].[Parameter 4] = &quot;Revenue&quot; THEN&#13;&#10;[Actual Revenue]&#13;&#10;ELSEIF [Parameters].[Parameter 4]=&quot;Profit&quot; THEN&#13;&#10;[Actual Profit]&#13;&#10;ELSEIF [Parameters].[Parameter 4]=&quot;Shipping Cost&quot; THEN&#13;&#10;[Shipping Cost]&#13;&#10;ELSE&#13;&#10;[Quantity]&#13;&#10;END' />
