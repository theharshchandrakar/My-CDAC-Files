            <column datatype='date' name='[Expected Ship Date]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Order ID]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_905786481560154124]' derivation='None' name='[none:Calculation_905786481560154124:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_905786481555648520]' derivation='User' name='[usr:Calculation_905786481555648520:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
