      <column caption='Above Revenue Reference Parameter?' datatype='boolean' name='[Calculation_905786481528483840]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([Actual Revenue]) &gt; [Parameters].[Parameter 1]' />
      </column>
      <column caption='Above Quantity Reference' datatype='boolean' name='[Calculation_905786481532870658]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM([Quantity])&gt;[Parameters].[Parameter 2]' />
      </column>
      <column caption='Total Revenue' datatype='real' default-format='c&quot;$&quot;#,##0,K' name='[Calculation_905786481554935811]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Actual Revenue])' />
      </column>
      <column caption='Total Profit' datatype='real' default-format='c&quot;$&quot;#,##0,K' name='[Calculation_905786481555333124]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Actual Profit])' />
      </column>
      <column caption='Total Quantity' datatype='integer' name='[Calculation_905786481555419141]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Quantity])' />
      </column>
      <column caption='Total Shipping Cost' datatype='real' default-format='c&quot;$&quot;#,##0,K' name='[Calculation_905786481555533830]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='sum([Shipping Cost])' />
      </column>
      <column caption='Avg Discount' datatype='real' default-format='p0.0%' name='[Calculation_905786481555599367]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Discount])' />
      </column>
      <column caption='No. of Orders' datatype='integer' name='[Calculation_905786481555648520]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order ID])' />
